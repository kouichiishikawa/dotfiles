# 人によって違う値（user.name・user.email・user.signingkey）は手元だけの ~/.gitconfig.local に置く
# （公開リポジトリに載せない）。最後に読み込むので、ここの値を上書きできる
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[core]
	editor = code --wait
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
[merge]
	tool = code --wait \"$MERGED\"
[init]
	defaultBranch = main
[pull]
	rebase = true
[fetch]
	prune = true
[push]
	default = simple
[url "git@github.com:"]
	insteadOf = https://github.com/
# 署名は 1Password の SSH 鍵で行う（鍵は ~/.gitconfig.local の user.signingkey）
[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
[commit]
	gpgsign = true
[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[include]
	path = ~/.gitconfig.local
