# Theme
theme = Vercel
# キャレット色（テーマのピンクを上書き）
cursor-color = #316EEE

# Font
# Moralerspace Neon HW（和文と英字の幅が 1:2。Brewfile の font-moralerspace-hw。Nerd Font の記号入り）
# cmux はこのファイルのあとに ~/Library/Application Support/com.cmuxterm.app/config.ghostty を読む。
# そちらに font-family / font-size があると、ここの指定は上書きされる（2026-11 は SF Mono 12pt が効いていた）。
# フォントはここだけで決め、cmux 側には書かない。
# ①② ※ ○ → などは East Asian Width が Ambiguous で、Ghostty も Claude Code も 1 マスとして扱う。
# どのフォントでも 1 マスの幅に縮めて描かれるので、見やすさは font-size で決まる。
# HW 版の 16pt は、3:5 の Moralerspace Neon 14pt と 1 マスの幅が同じで、字が大きく、漢字の間に隙間が出ない。
font-family = "Moralerspace Neon HW"
font-size = 16

# Line Height (デフォルト: 0 = 1.0倍)
# 10% = 約1.1倍
adjust-cell-height = 10%

# Window behavior
window-inherit-working-directory = true
# 新規ワークスペースはホーム、新規タブは現在のワークスペースの場所で開く
working-directory = home
tab-inherit-working-directory = true
window-save-state = always
macos-titlebar-style = tabs

# Keybindings
keybind = shift+enter=text:\x1b\r
