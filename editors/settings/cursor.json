{
    "workbench.iconTheme": "material-icon-theme",
    "editor.suggestSelection": "first",
    "vsintellicode.modify.editor.suggestSelection": "automaticallyOverrodeDefaultValue",
    "security.workspace.trust.untrustedFiles": "open",
    "vsicons.dontShowNewVersionMessage": true,
    "editor.fontFamily": "Source Han Code JP",
    "editor.unicodeHighlight.nonBasicASCII": false,
    "editor.unicodeHighlight.ambiguousCharacters": false,
    "files.autoGuessEncoding": true,
    "editor.stickyTabStops": true,
    "[html]": {
        "editor.defaultFormatter": "vscode.html-language-features"
    },
    "editor.unicodeHighlight.allowedCharacters": {
        "​": true
    },
    "figma.autocompleteBlocks": true,
    "settingsSync.ignoredSettings": [
        "figma.autocompleteBlocks"
    ],
    "git.autofetch": true,
    "editor.minimap.enabled": true,
    "editor.minimap.maxColumn": 80,
    "editor.minimap.sectionHeaderFontSize": 8,
    "git.confirmSync": false,
    "cursor.windowSwitcher.sidebarHoverCollapsed": true,
    "git.openRepositoryInParentFolders": "never",
    // ファイル保存時、最終行に改行を挿入する
    "files.insertFinalNewline": true,
    // ファイル保存時、最終行以降の空行を削除する
    "files.trimFinalNewlines": true,
    // ファイル保存時、末尾の空白をトリミングする
    "files.trimTrailingWhitespace": true,
    // 保存時に自動整形する,
    "editor.formatOnSave": true,
}
